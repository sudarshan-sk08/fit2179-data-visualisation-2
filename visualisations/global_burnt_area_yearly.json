{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 950,
  "height": 520,

  "background": "#1a1917",

  "params": [
    {
      "name": "selectedYear",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2026,
        "step": 1,
        "name": "Year: "
      }
    }
  ],

  "projection": {
    "type": "naturalEarth1"
  },

  "layer": [
    {
      "data": { "sphere": true },
      "mark": { "type": "geoshape", "fill": "#0d0d0d" }
    },

    {
      "data": { "graticule": { "step": [30, 30] } },
      "mark": {
        "type": "geoshape",
        "stroke": "#2b2b2b",
        "strokeWidth": 0.4,
        "fill": null
      }
    },

    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#242424",
        "stroke": "#111111",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "calculate": "datum.properties.name == 'United States of America' ? 'United States' : datum.properties.name == 'Democratic Republic of the Congo' ? 'Democratic Republic of Congo' : datum.properties.name == 'Central African Rep.' ? 'Central African Republic' : datum.properties.name == 'South Sudan' ? 'South Sudan' : datum.properties.name",
          "as": "normalized_name"
        },
        {
          "lookup": "normalized_name",
          "from": {
            "data": {
              "url": "../data/annual-area-burnt-per-wildfire-wide.csv",
              "format": { "type": "csv" }
            },
            "key": "Entity",
            "fields": [
              "Entity",
              "y2012",
              "y2013",
              "y2014",
              "y2015",
              "y2016",
              "y2017",
              "y2018",
              "y2019",
              "y2020",
              "y2021",
              "y2022",
              "y2023",
              "y2024",
              "y2025",
              "y2026"
            ]
          }
        },
        {
          "calculate": "toNumber(datum['y' + selectedYear])",
          "as": "burnt"
        },
        {
          "calculate": "selectedYear",
          "as": "Year"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#111111",
        "strokeWidth": 0.5
      },

      "encoding": {
        "color": {
          "field": "burnt",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [0, 800],
            "clamp": true,
            "range": [
              "#faeeca",
              "#ffe28c",
              "#ffea78",
              "#ff9100",
              "#bd6b00"
            ]
          },
          "legend": {
            "title": "Avg hectares per fire",
            "orient": "bottom-right",
            "titleColor": "#aaaaaa",
            "labelColor": "#aaaaaa"
          }
        },

        "tooltip": [
          {
            "field": "Entity",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "burnt",
            "type": "quantitative",
            "title": "Avg Area Burnt",
            "format": ",.1f"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          }
        ]
      }
    }
  ],

  "title": {
    "text": "Average Area Burnt Per Wildfire Event",
    "subtitle": "Use slider to explore yearly wildfire severity",
    "color": "#ffffff",
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  }
}