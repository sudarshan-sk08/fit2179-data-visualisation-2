{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1200,
  "height": 600,
  "background": "#1a1917",
  "params": [
    {
      "name": "selectedYear",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2026,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "naturalEarth1"
  },
  "layer": [
    {
      "data": { "sphere": true },
      "mark": { "type": "geoshape", "fill": "#0d0d0d" }
    },
    {
      "data": { "graticule": { "step": [30, 30] } },
      "mark": {
        "type": "geoshape",
        "stroke": "#2b2b2b",
        "strokeWidth": 0.4,
        "fill": null
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#242424",
        "stroke": "#111111",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "transform": [
        {
          "calculate": "datum.properties.name == 'United States of America' ? 'United States' : datum.properties.name == 'Democratic Republic of the Congo' ? 'Democratic Republic of Congo' : datum.properties.name == 'Central African Rep.' ? 'Central African Republic' : datum.properties.name == 'South Sudan' ? 'South Sudan' : datum.properties.name",
          "as": "normalized_name"
        },
        {
          "lookup": "normalized_name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/sudarshan-sk08/fit2179-data-visualisation-2/main/data/annual-area-burnt-per-wildfire-wide.csv",
              "format": { "type": "csv" }
            },
            "key": "Entity",
            "fields": [
              "Entity",
              "y2012","y2013","y2014","y2015","y2016","y2017","y2018","y2019",
              "y2020","y2021","y2022","y2023","y2024","y2025","y2026"
            ]
          }
        },
        {
          "calculate": "toNumber(datum['y' + selectedYear])",
          "as": "burnt"
        },
        {
          "calculate": "selectedYear",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#111111",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "burnt",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [0, 1300],
            "clamp": true,
            "range": ["#FFDA6B", "#FF8C00", "#CC2200"]
          },
          "legend": {
            "title": "Avg hectares per fire",
            "orient": "bottom-right",
            "titleColor": "#7a6e65",
            "labelColor": "#e8e0d5",
            "gradientLength": 140,
            "gradientThickness": 10
          }
        },
        "tooltip": [
          { "field": "Entity", "type": "nominal",      "title": "Country" },
          { "field": "burnt",  "type": "quantitative", "title": "Avg Area Burnt", "format": ",.1f" },
          { "field": "Year",   "type": "ordinal",       "title": "Year" }
        ]
      }
    }
  ],
  "title": {
    "text": "Average Area Burnt Per Wildfire Event",
    "subtitle": "Use the slider to view different years",
    "color": "#e8e0d5",
    "subtitleColor": "#7a6e65",
    "anchor": "start"
  }
}
