  "transform": [
    { "filter": "datum.year == selectedYear" },
    {
      "aggregate": [
        { "op": "max", "field": "max_temp", "as": "max_temp" },
        { "op": "min", "field": "min_temp", "as": "min_temp" }
      ],
      "groupby": ["state", "state_full"]
    },
    {
      "calculate": "datum.max_temp - datum.min_temp",
      "as": "range"
    }
  ],
  "layer": [
    {
      "description": "Floating bars from min_temp to max_temp per state",
      "mark": {
        "type": "bar",
        "width": 28,
        "cornerRadiusTopLeft": 3,
        "cornerRadiusTopRight": 3
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": ["AUS", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "min_temp",
          "type": "quantitative",
          "scale": { "domain": [15, 55] },
          "axis": { "title": "Temperature (°C)", "tickCount": 8 }
        },
        "y2": { "field": "max_temp" },
        "color": {
          "field": "max_temp",
          "type": "quantitative",
          "scale": {
            "domain": [36, 52],
            "range": ["#FFDA6B", "#FF8C00", "#CC2200"]
          },
          "legend": {
            "title": "Peak Temp (°C)",
            "orient": "right",
            "gradientLength": 100
          }
        },
        "tooltip": [
          { "field": "state_full", "type": "nominal",      "title": "State" },
          { "field": "max_temp",   "type": "quantitative", "title": "Highest Maximum (°C)", "format": ".1f" },
          { "field": "min_temp",   "type": "quantitative", "title": "Highest Minimum (°C)", "format": ".1f" },
          { "field": "range",      "type": "quantitative", "title": "Range (°C)",            "format": ".1f" }
        ]
      }
    },
    {
      "description": "Tick mark at the top (max temp)",
      "mark": { "type": "tick", "color": "#ffffff", "opacity": 0.6, "width": 28, "thickness": 2 },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": ["AUS", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
        },
        "y": { "field": "max_temp", "type": "quantitative" }
      }
    },
    {
      "description": "Tick mark at the bottom (min temp)",
      "mark": { "type": "tick", "color": "#ffffff", "opacity": 0.6, "width": 28, "thickness": 2 },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": ["AUS", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
        },
        "y": { "field": "min_temp", "type": "quantitative" }
      }
    },
    {
      "description": "Max temp label above bar",
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#e8e0d5"
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
