{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Floating range bars showing highest maximum and minimum temperatures per state.",
  "width": 750,
  "height": 420,
  "background": "#111010",
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelColor": "#e8e0d5",
      "titleColor": "#7a6e65",
      "gridColor": "#252220",
      "domainColor": "#353030",
      "tickColor": "#353030",
      "labelFontSize": 12
    },
    "legend": {
      "labelColor": "#e8e0d5",
      "titleColor": "#7a6e65"
    },
    "title": {
      "color": "#e8e0d5",
      "subtitleColor": "#7a6e65",
      "anchor": "start",
      "fontSize": 15,
      "subtitleFontSize": 12,
      "offset": 14
    }
  },
  "title": {
    "text": "Extreme Temperature Records by State",
    "subtitle": "Floating bars show the range between highest minimum and highest maximum temperature"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2016,
        "max": 2026,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "data": {
    "url": "../data/states-max-min-temp.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "max_temp": "number", "min_temp": "number"}
    }
  },
  "transform": [
    { "filter": "datum.year == selectedYear" },
    {
      "lookup": "state",
      "from": {
        "data": {
          "values": [
            {"state": "NSW", "state_full": "New South Wales"},
            {"state": "VIC", "state_full": "Victoria"},
            {"state": "QLD", "state_full": "Queensland"},
            {"state": "SA",  "state_full": "South Australia"},
            {"state": "WA",  "state_full": "Western Australia"},
            {"state": "TAS", "state_full": "Tasmania"},
            {"state": "NT",  "state_full": "Northern Territory"}
          ]
        },
        "key": "state",
        "fields": ["state_full"]
      }
    },
    {"calculate": "datum.max_temp - datum.min_temp", "as": "range"}
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": 28,
        "cornerRadiusTopLeft": 3,
        "cornerRadiusTopRight": 3
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"],
          "axis": {"title": null, "labelAngle": 0, "labelFontSize": 12}
        },
        "y": {
          "field": "min_temp",
          "type": "quantitative",
          "scale": {"domain": [15, 55]},
          "axis": {"title": "Temperature (°C)", "tickCount": 8}
        },
        "y2": { "field": "max_temp" },
        "color": {
          "field": "max_temp",
          "type": "quantitative",
          "scale": {"domain": [36, 52], "range": ["#FFDA6B", "#FF8C00", "#CC2200"]},
          "legend": {"title": "Peak Temp (°C)", "orient": "right", "gradientLength": 100}
        },
        "tooltip": [
          {"field": "state_full", "type": "nominal",      "title": "State" },
          {"field": "max_temp",   "type": "quantitative", "title": "Highest Maximum (°C)", "format": ".1f"},
          {"field": "min_temp",   "type": "quantitative", "title": "Highest Minimum (°C)", "format": ".1f"},
          {"field": "range",      "type": "quantitative", "title": "Range (°C)",            "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "tick", "color": "#ffffff", "opacity": 0.6, "width": 28, "thickness": 2 },
      "encoding": {
        "x": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"]},
        "y": {"field": "max_temp", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "tick", "color": "#ffffff", "opacity": 0.6, "width": 28, "thickness": 2},
      "encoding": {
        "x": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"]},
        "y": {"field": "min_temp", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "text", "dy": -8, "fontSize": 11, "fontWeight": "bold", "color": "#e8e0d5" },
      "encoding": {
        "x": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"]},
        "y": {"field": "max_temp", "type": "quantitative"},
        "text": {"field": "max_temp", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "mark": {"type": "text", "dy": 14, "fontSize": 11, "color": "#7a6e65"},
      "encoding": {
        "x": {"field": "state", "type": "nominal", "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT"]},
        "y": {"field": "min_temp", "type": "quantitative"},
        "text": {"field": "min_temp", "type": "quantitative", "format": ".1f"}
      }
    }
  ]
}